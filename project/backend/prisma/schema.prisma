generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(255)
  passwordHash       String?             @map("password_hash") @db.VarChar(255)
  hashedRefreshToken String?             @map("hashed_refresh_token") @db.VarChar(255)
  username           String              @unique @db.VarChar(50)
  displayName        String?             @map("display_name")
  avatarUrl          String?             @map("avatar_url")
  balance            Decimal             @default(10000)
  totalDeposited     Decimal             @default(0) @map("total_deposited")
  oauthProvider      String?             @map("oauth_provider") @db.VarChar(50)
  oauthId            String?             @map("oauth_id") @db.VarChar(255)
  twoFactorSecret    String?             @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabled   Boolean             @default(false) @map("two_factor_enabled")
  language           String              @default("en") @db.VarChar(5)
  isOnline           Boolean             @default(false) @map("is_online")
  lastSeen           DateTime?           @map("last_seen")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  holdings           Holding[]
  orders             Order[]
  portfolioSnapshots PortfolioSnapshot[]
  sentFriendRequests     Friendship[]   @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]   @relation("FriendshipAddressee")
  sentMessages           Message[]      @relation("MessageSender")
  receivedMessages       Message[]      @relation("MessageReceiver")
  notifications          Notification[]
  @@map("users")
}

model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  symbol         String    @unique
  name           String
  type           AssetType
  currentPrice   Decimal   @default(0) @map("current_price") @db.Decimal(15, 6)
  change24h      Decimal   @default(0) @map("change_24h") @db.Decimal(10, 4)
  high24h        Decimal   @default(0) @map("high_24h") @db.Decimal(15, 6)
  low24h         Decimal   @default(0) @map("low_24h") @db.Decimal(15, 6)
  volume24h      Decimal   @default(0) @map("volume_24h") @db.Decimal(20, 2)
  marketCap      Decimal   @default(0) @map("market_cap") @db.Decimal(20, 2)
  logoUrl        String?   @map("logo_url")
  coingeckoId    String?   @map("coingecko_id")
  finnhubSymbol  String?   @map("finnhub_symbol")
  isActive       Boolean   @default(true) @map("is_active")
  priceUpdatedAt DateTime? @map("price_updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  holdings       Holding[]
  orders         Order[]

  @@map("assets")
}

model Order {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  assetId   String             @map("asset_id") @db.Uuid
  type      OrderType
  orderType OrderExecutionType @map("order_type")
  quantity  Decimal            @db.Decimal(15, 8)
  price     Decimal            @db.Decimal(15, 6)
  total     Decimal            @db.Decimal(15, 2)
  status    OrderStatus        @default(PENDING)
  filledAt  DateTime?          @map("filled_at") @db.Timestamp(6)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  asset     Asset              @relation(fields: [assetId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, orderType])
  @@map("orders")
}

model Holding {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  quantity    Decimal  @db.Decimal(15, 8)
  avgBuyPrice Decimal  @map("avg_buy_price") @db.Decimal(15, 6)
  updatedAt   DateTime @updatedAt @map("updated_at")
  asset       Asset    @relation(fields: [assetId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, assetId])
  @@index([userId])
  @@map("holdings")
}

model PortfolioSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  totalValue    Decimal  @map("total_value") @db.Decimal(15, 2)
  balance       Decimal  @db.Decimal(15, 2)
  holdingsValue Decimal  @map("holdings_value") @db.Decimal(15, 2)
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("portfolio_snapshots")
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@map("friendships")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  content    String   @db.VarChar(2000)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AssetType {
  STOCK
  CRYPTO
  FOREX
  COMMODITY
}

enum OrderType {
  BUY
  SELL
}

enum OrderExecutionType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  PROCESSING
  FILLED
  CANCELLED
}
